{
    "name": "thejoker-vibe-coding-ide",
    "version": "1.0.0",
    "description": "The Joker — Vibe Coding IDE | Professional AI-powered desktop IDE built with Electron, React, and TypeScript",
    "main": "dist-electron/main.js",
    "author": "Ratna Kirti",
    "license": "MIT",
    "scripts": {
        "dev": "vite",
        "dev:electron": "vite --mode electron",
        "build": "tsc && vite build",
        "build:mac": "vite build && electron-builder --mac",
        "build:win": "vite build && electron-builder --win",
        "build:linux": "vite build && electron-builder --linux",
        "make": "npm run build && electron-builder --win --config",
        "rebuild": "electron-rebuild -f -w node-pty",
        "preview": "vite preview"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.6.0",
        "chokidar": "^3.6.0",
        "lucide-react": "^0.300.0",
        "monaco-editor": "^0.44.0",
        "node-pty": "^1.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "xterm": "^5.3.0",
        "xterm-addon-fit": "^0.8.0",
        "xterm-addon-web-links": "^0.9.0",
        "zustand": "^4.4.7"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.17",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "electron-rebuild": "^3.2.9",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.3",
        "vite": "^5.0.10",
        "vite-plugin-electron": "^0.28.0",
        "vite-plugin-electron-renderer": "^0.14.5"
    },
    "build": {
        "appId": "com.thejoker.vibecoding.ide",
        "productName": "The Joker - Vibe Coding IDE",
        "directories": {
            "output": "../electron/out"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "public/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "build/theJoker.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "build/theJoker.ico",
            "uninstallerIcon": "build/theJoker.ico",
            "installerHeaderIcon": "build/theJoker.ico"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage"
        }
    }
}